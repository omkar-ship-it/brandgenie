# Copy to .env.local for local dev. Production values live in Vercel.
DATABASE_URL=postgres://localhost:5432/brandgenie

# Leave MSG91_* unset and OTP codes print to the server console instead.
# MSG91_AUTH_KEY=
# MSG91_EMAIL_DOMAIN=
# MSG91_FROM_EMAIL=
# MSG91_FROM_NAME=BrandGenie
# MSG91_EMAIL_TEMPLATE_ID=
# MSG91_GIFT_TEMPLATE_ID=

# Leave Razorpay unset and bidding runs in a labelled test mode.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
